---
/**
 * ブログ記事を内容の近さでたどる「記事エクスプローラ」。
 *
 * src/build-related.mjs（npm run build-related）が生成する TF-IDF インデックスを
 * ビルド時に読み込み、静的 HTML と少量の素の JS だけで動作する（実行時 API 呼び出しなし）。
 * 表示テキストは i18n 辞書から引き、Welcome.astro と同じ data-i18n 系属性でクライアント側で切り替える。
 */
import related from '../data/related.json';
import { translations, type TranslationKey } from '../data/i18n';

interface RelatedPost {
	url: string;
	title: string;
	score: number;
}

interface Entry {
	url: string;
	title: string;
	date: string;
	categories: string[];
	related: RelatedPost[];
}

const t = (key: TranslationKey): string => translations.ja[key];
// 件数を埋め込む文言（クライアント側では data-i18n-template + data-i18n-count で再描画される）
const tc = (key: TranslationKey, count: number): string => t(key).replace('{count}', String(count));

const posts = related as Entry[];
const categories = [...new Set(posts.flatMap((p) => p.categories))].sort((a, b) => a.localeCompare(b, 'ja'));
const percent = (score: number): number => Math.round(score * 100);
---

<section id="articles" class="mb-12 scroll-mt-4">
	<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900" data-i18n="section.articles">{t('section.articles')}</h2>
	<p class="text-sm text-gray-600 leading-relaxed mb-5" data-i18n-template="articles.description" data-i18n-count={posts.length}>
		{tc('articles.description', posts.length)}
	</p>

	<div class="flex flex-col sm:flex-row gap-3 mb-5">
		<div class="flex-1">
			<label for="ae-search" class="sr-only" data-i18n="articles.searchLabel">{t('articles.searchLabel')}</label>
			<input
				type="search"
				id="ae-search"
				placeholder={t('articles.searchPlaceholder')}
				data-i18n-placeholder="articles.searchPlaceholder"
				autocomplete="off"
				class="w-full rounded-lg border border-gray-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
			/>
		</div>
		<div>
			<label for="ae-category" class="sr-only" data-i18n="articles.categoryLabel">{t('articles.categoryLabel')}</label>
			<select
				id="ae-category"
				class="w-full sm:w-48 rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
			>
				<option value="" data-i18n="articles.allCategories">{t('articles.allCategories')}</option>
				{categories.map((c) => <option value={c}>{c}</option>)}
			</select>
		</div>
	</div>

	<p id="ae-count" class="text-xs text-gray-500 mb-3" role="status" aria-live="polite" data-i18n-template="articles.count" data-i18n-count={posts.length}>
		{tc('articles.count', posts.length)}
	</p>

	<ul id="ae-list" class="flex flex-col gap-2.5 max-h-[32rem] overflow-y-auto pr-14 sm:pr-1 list-none p-0 m-0">
		{posts.map((p) => (
			<li
				class="ae-item rounded-xl border border-gray-200 bg-white"
				data-title={p.title.toLowerCase()}
				data-categories={p.categories.join('|')}
			>
				<article>
					<h3 class="m-0">
						<button
							type="button"
							class="ae-toggle w-full text-left px-4 py-3 flex items-start gap-3 rounded-xl hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
							aria-expanded="false"
						>
							<span class="flex-1 min-w-0">
								<span class="block text-sm font-semibold text-gray-900">{p.title}</span>
								<span class="block text-xs text-gray-500 mt-0.5">
									<time datetime={p.date}>{p.date}</time>
									{p.categories.length > 0 && <span> ・ {p.categories.join(' / ')}</span>}
								</span>
							</span>
							<svg
								class="ae-chevron w-4 h-4 mt-1 shrink-0 text-gray-400 transition-transform"
								viewBox="0 0 20 20"
								fill="currentColor"
								aria-hidden="true"
								focusable="false"
							>
								<path
									fill-rule="evenodd"
									d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
									clip-rule="evenodd"
								/>
							</svg>
						</button>
					</h3>

					<div class="ae-panel hidden border-t border-gray-100 px-4 py-3">
						<a
							href={p.url}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block text-xs font-semibold text-indigo-600 hover:text-purple-500 hover:underline mb-3"
							data-i18n="articles.read"
						>
							{t('articles.read')}
						</a>

						{p.related.length > 0 ? (
							<>
								<p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-2" data-i18n="articles.related">{t('articles.related')}</p>
								<ul class="flex flex-col gap-2 list-none p-0 m-0">
									{p.related.map((r) => (
										<li class="flex items-center gap-3">
											<span class="shrink-0 w-16 h-1.5 rounded-full bg-gray-200 overflow-hidden" aria-hidden="true">
												<span class="block h-full rounded-full bg-indigo-500" style={`width:${percent(r.score)}%`} />
											</span>
											<span class="shrink-0 w-9 text-xs text-gray-500 tabular-nums">
												<span class="sr-only" data-i18n="articles.similarity">{t('articles.similarity')}</span>
												{' '}{percent(r.score)}%
											</span>
											<a
												href={r.url}
												target="_blank"
												rel="noopener noreferrer"
												class="text-sm text-indigo-600 hover:text-purple-500 hover:underline"
											>
												{r.title}
											</a>
										</li>
									))}
								</ul>
							</>
						) : (
							<p class="text-xs text-gray-500" data-i18n="articles.noRelated">{t('articles.noRelated')}</p>
						)}
					</div>
				</article>
			</li>
		))}
	</ul>

	<p id="ae-empty" class="hidden text-sm text-gray-500 py-6 text-center" data-i18n="articles.noResults">
		{t('articles.noResults')}
	</p>
</section>

<script>
	import { translations, isLang, DEFAULT_LANG } from '../data/i18n';

	const root = document.getElementById('articles');
	if (root) {
		const search = root.querySelector<HTMLInputElement>('#ae-search')!;
		const category = root.querySelector<HTMLSelectElement>('#ae-category')!;
		const count = root.querySelector<HTMLElement>('#ae-count')!;
		const empty = root.querySelector<HTMLElement>('#ae-empty')!;
		const items = Array.from(root.querySelectorAll<HTMLElement>('.ae-item'));

		// 現在の言語は Welcome.astro が <html lang> に反映している
		const countLabel = (visible: number): string => {
			const lang = document.documentElement.lang;
			const dict: Record<string, string> = translations[isLang(lang) ? lang : DEFAULT_LANG];
			return (dict['articles.count'] ?? '{count}').replace('{count}', String(visible));
		};

		const apply = () => {
			const q = search.value.trim().toLowerCase();
			const cat = category.value;
			let visible = 0;

			for (const item of items) {
				const title = item.dataset.title ?? '';
				const cats = (item.dataset.categories ?? '').split('|');
				const hit = (!q || title.includes(q)) && (!cat || cats.includes(cat));
				item.hidden = !hit;
				if (hit) visible++;
			}

			// 言語切り替え時に再描画できるよう件数も属性に残す
			count.dataset.i18nCount = String(visible);
			count.textContent = countLabel(visible);
			empty.classList.toggle('hidden', visible > 0);
		};

		search.addEventListener('input', apply);
		category.addEventListener('change', apply);

		root.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ae-toggle');
			if (!btn) return;

			const panel = btn.closest('article')!.querySelector<HTMLElement>('.ae-panel')!;
			const open = btn.getAttribute('aria-expanded') === 'true';

			btn.setAttribute('aria-expanded', String(!open));
			panel.classList.toggle('hidden', open);
			btn.querySelector('.ae-chevron')?.classList.toggle('rotate-180', !open);
		});
	}
</script>
