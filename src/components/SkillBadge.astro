---
import { getSkillIcon, FALLBACK_COLOR } from '../data/skill-icons';

interface Props {
	name: string;
}

const { name } = Astro.props;

const icon = getSkillIcon(name);
const color = icon ? `#${icon.hex}` : FALLBACK_COLOR;
---

<li class="flex items-center gap-2 border border-gray-200 rounded-full px-3 py-1.5 text-sm font-medium bg-white hover:shadow-md transition-shadow cursor-default select-none">
	{icon ? (
		<svg
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
			class="w-4 h-4 shrink-0"
			style={`fill: ${color};`}
			aria-hidden="true"
			focusable="false"
		>
			<path d={icon.path} />
		</svg>
	) : (
		<span class="w-4 h-4 shrink-0 rounded-full inline-block" style={`background: ${color};`} aria-hidden="true"></span>
	)}
	<span class="text-gray-700">{name}</span>
</li>

