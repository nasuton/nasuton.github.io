---
// プロフィール画像は public/profile.jpg に配置してください
import SkillBadge from './SkillBadge.astro';
// src/fetch-posts.mjs（npm run fetch-posts）で生成される最新記事一覧
import blogPosts from '../data/posts.json';
// 表示テキストの多言語辞書（ビルド時は日本語で描画し、クライアント側で切り替える）
import { translations, type TranslationKey } from '../data/i18n';

const t = (key: TranslationKey): string => translations.ja[key];

interface BlogPost {
	title: string;
	url: string;
	date: string;
	excerpt: string;
	thumb: string | null;
}

interface PortfolioItem {
	/** i18n キーのプレフィックス（portfolio.<key>.title など） */
	key: 'blog' | 'password';
	url?: string;
	techs: string[];
	posts?: BlogPost[];
}

// WordPress API が返す HTML エンティティ（&#8230; など）をデコードする
const decodeEntities = (text: string): string =>
	text
		.replace(/&#(\d+);/g, (_, code) => String.fromCodePoint(Number(code)))
		.replace(/&#x([0-9a-f]+);/gi, (_, code) => String.fromCodePoint(parseInt(code, 16)))
		.replace(/&amp;/g, '&')
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/&quot;/g, '"')
		.replace(/&nbsp;/g, ' ')
		.trim();

const formatDate = (date: string): string =>
	new Date(date).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

const latestPosts: BlogPost[] = (blogPosts as BlogPost[]).map((post) => ({
	...post,
	title: decodeEntities(post.title),
	excerpt: decodeEntities(post.excerpt),
}));

const portfolio: PortfolioItem[] = [
	{
		key: 'blog',
		url: 'https://nasuton.net/blog/',
		techs: ['WordPress'],
		posts: latestPosts,
	},
	{
		key: 'password',
		url: 'https://nasuton.github.io/PasswordGeneration/',
		techs: ['Go', 'Gin', 'React', 'TypeScript'],
	},
];

const skills = [
	'JavaScript',
	'TypeScript',
	'Python',
	'Rust',
	'C#',
	'C++',
	'Kotlin',
	'Linux',
	'Angular',
	'React',
	'Node.js',
	'Git',
	'GitHub',
	'Docker',
	'SQL Server',
	'PowerShell',
	'MySQL',
	'Go',
	'Gin',
];
---

<div class="font-sans max-w-2xl mx-auto px-6 py-10 pb-16 text-gray-900">

	<!-- プロフィールヘッダー（共通） -->
	<header class="relative flex flex-col items-center text-center mb-10">
		<!-- 言語切り替え -->
		<div
			class="absolute top-0 right-0 inline-flex items-center rounded-lg border border-gray-200 bg-gray-50 p-0.5 text-xs font-semibold"
			role="group"
			aria-label={t('header.langSwitch')}
			data-i18n-aria-label="header.langSwitch"
		>
			<button
				type="button"
				class="lang-btn px-2.5 py-1 rounded-md transition-colors bg-white text-indigo-600 shadow-sm"
				data-lang="ja"
				lang="ja"
				aria-pressed="true"
			>
				日本語
			</button>
			<button
				type="button"
				class="lang-btn px-2.5 py-1 rounded-md transition-colors text-gray-500 hover:text-gray-700"
				data-lang="en"
				lang="en"
				aria-pressed="false"
			>
				EN
			</button>
		</div>

		<div class="w-28 h-28 rounded-full overflow-hidden mb-4 bg-gray-200 border-4 border-gray-300 flex items-center justify-center">
			<img
				id="profile-image"
				src="/profile.jpg"
				alt={t('header.profileAlt')}
				data-i18n-alt="header.profileAlt"
				width="240"
				height="240"
				class="w-full h-full object-cover"
			/>
			<div id="profile-placeholder" class="hidden w-full h-full items-center justify-center text-gray-400">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16" aria-hidden="true" focusable="false">
					<path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
				</svg>
			</div>
		</div>
		<h1 class="text-3xl sm:text-4xl font-bold mb-2 leading-snug" data-i18n="header.name">{t('header.name')}</h1>
		<p class="text-base text-gray-500" data-i18n="header.tagline">{t('header.tagline')}</p>
	</header>

	<!-- タブボタン -->
	<div class="flex gap-2 mb-8 border-b border-gray-200" role="tablist" aria-label={t('tab.ariaLabel')} data-i18n-aria-label="tab.ariaLabel">
		<button
			type="button"
			id="tab-general"
			class="tab-btn px-5 py-2.5 text-sm font-semibold rounded-t-lg border-b-2 transition-colors border-indigo-500 text-indigo-600 bg-indigo-50"
			role="tab"
			aria-selected="true"
			aria-controls="content-general"
			data-tab="general"
		>
			🌸 <span data-i18n="tab.general">{t('tab.general')}</span>
		</button>
		<button
			type="button"
			id="tab-tech"
			class="tab-btn px-5 py-2.5 text-sm font-semibold rounded-t-lg border-b-2 transition-colors border-transparent text-gray-500 hover:text-gray-700"
			role="tab"
			aria-selected="false"
			aria-controls="content-tech"
			data-tab="tech"
		>
			💻 <span data-i18n="tab.tech">{t('tab.tech')}</span>
		</button>
	</div>

	<!-- 目次（一般タブ） -->
	<nav id="toc-general" class="bg-gray-50 border border-gray-200 rounded-xl px-6 py-5 mb-12" aria-label={t('toc.generalAria')} data-i18n-aria-label="toc.generalAria">
		<h2 class="text-sm font-bold text-gray-600 uppercase tracking-widest mb-3" data-i18n="toc.title">{t('toc.title')}</h2>
		<ol class="list-decimal list-inside flex flex-col gap-1.5">
			<li><a href="#profile" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors" data-i18n="section.profile">{t('section.profile')}</a></li>
			<li><a href="#hobby" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors" data-i18n="section.hobby">{t('section.hobby')}</a></li>
			<li><a href="#camera" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors" data-i18n="section.camera">{t('section.camera')}</a></li>
			<li><a href="#sns-general" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors" data-i18n="section.links">{t('section.links')}</a></li>
		</ol>
	</nav>

	<!-- 目次（技術タブ） -->
	<nav id="toc-tech" class="hidden bg-gray-50 border border-gray-200 rounded-xl px-6 py-5 mb-12" aria-label={t('toc.techAria')} data-i18n-aria-label="toc.techAria">
		<h2 class="text-sm font-bold text-gray-600 uppercase tracking-widest mb-3" data-i18n="toc.title">{t('toc.title')}</h2>
		<ol class="list-decimal list-inside flex flex-col gap-1.5">
			<li><a href="#profile" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors" data-i18n="section.profile">{t('section.profile')}</a></li>
			<li><a href="#skills" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors" data-i18n="section.skills">{t('section.skills')}</a></li>
			<li><a href="#portfolio" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors" data-i18n="section.portfolio">{t('section.portfolio')}</a></li>
			<li><a href="#sns-tech" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors" data-i18n="section.links">{t('section.links')}</a></li>
		</ol>
	</nav>

	<main class="min-h-full">
		<!-- プロフィールセクション（共通） -->
		<section id="profile" class="mb-12 scroll-mt-4">
			<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900" data-i18n="section.profile">{t('section.profile')}</h2>
			<div>
				<p class="text-gray-600 leading-relaxed">
					<span data-i18n="profile.line1">{t('profile.line1')}</span><br />
					<span data-i18n="profile.line2">{t('profile.line2')}</span>
				</p>
			</div>
		</section>

		<!-- ===== 技術タブ ===== -->
		<div id="content-tech" class="hidden" role="tabpanel" aria-labelledby="tab-tech">
			<!-- スキルセクション -->
			<section id="skills" class="mb-12 scroll-mt-4">
				<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900" data-i18n="section.skills">{t('section.skills')}</h2>
				<ul class="flex flex-wrap gap-2 list-none p-0 m-0">
					{skills.map((skill) => (
						<SkillBadge name={skill} />
					))}
				</ul>
			</section>

			<!-- ポートフォリオセクション -->
			<section id="portfolio" class="mb-12 scroll-mt-4">
				<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900" data-i18n="section.portfolio">{t('section.portfolio')}</h2>
				<div class="flex flex-col gap-4">
					{portfolio.map((item) => (
						<div class="border border-gray-200 rounded-xl p-5 bg-white hover:shadow-md transition-shadow">
							<div class="flex items-start justify-between gap-3 mb-2">
								<h3 class="text-base font-semibold text-gray-900" data-i18n={`portfolio.${item.key}.title`}>{t(`portfolio.${item.key}.title`)}</h3>
								{item.url && (
									<a
										href={item.url}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold text-white bg-indigo-500 hover:bg-indigo-600 hover:-translate-y-0.5 transition-all shrink-0"
										aria-label={t(`portfolio.${item.key}.openAria`)}
										data-i18n-aria-label={`portfolio.${item.key}.openAria`}
									>
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true" focusable="false">
											<path d="M14 3v2H7v14h14v-7h2v8a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h8zm7 0v7h-2V6.413l-7.293 7.294-1.414-1.414L19.585 5H15V3h6z"/>
										</svg>
										<span data-i18n="portfolio.link">{t('portfolio.link')}</span>
									</a>
								)}
							</div>
							<p class="text-sm text-gray-600 leading-relaxed mb-3" data-i18n={`portfolio.${item.key}.description`}>{t(`portfolio.${item.key}.description`)}</p>
							{item.techs.length > 0 && (
								<div>
									<p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2" data-i18n="portfolio.techs">{t('portfolio.techs')}</p>
									<ul class="flex flex-wrap gap-2 list-none p-0 m-0">
										{item.techs.map((tech) => (
											<SkillBadge name={tech} />
										))}
									</ul>
								</div>
							)}
							{item.posts && item.posts.length > 0 && (
								<div class="mt-4 pt-4 border-t border-gray-100">
									<p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2" data-i18n="portfolio.latestPosts">{t('portfolio.latestPosts')}</p>
									<ul class="flex flex-col gap-2 list-none p-0 m-0">
										{item.posts.map((post) => (
											<li>
												<a
													href={post.url}
													target="_blank"
													rel="noopener noreferrer"
													class="group flex gap-3 items-start rounded-lg border border-gray-100 bg-gray-50 p-3 hover:bg-indigo-50 hover:border-indigo-200 transition-colors"
												>
													{post.thumb ? (
														<img
															src={post.thumb}
															alt=""
															width="96"
															height="64"
															loading="lazy"
															decoding="async"
															class="w-24 h-16 object-cover rounded-md shrink-0 bg-gray-200"
														/>
													) : (
														<div class="w-24 h-16 rounded-md shrink-0 bg-gray-200" aria-hidden="true"></div>
													)}
													<div class="min-w-0 flex-1">
														<time datetime={post.date} class="block text-xs text-gray-400 mb-0.5" data-i18n-date>{formatDate(post.date)}</time>
														<p class="text-sm font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors leading-snug mb-1">{post.title}</p>
														<p class="text-xs text-gray-500 leading-relaxed line-clamp-2">{post.excerpt}</p>
													</div>
												</a>
											</li>
										))}
									</ul>
								</div>
							)}
						</div>
					))}
				</div>
			</section>

			<!-- SNSセクション（技術タブ） -->
			<section id="sns-tech" class="mb-12 scroll-mt-4">
				<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900" data-i18n="section.links">{t('section.links')}</h2>
				<div class="flex flex-wrap gap-3">
					<a
						class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-black hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
						href="https://x.com/nasuton_matome" target="_blank" rel="noopener noreferrer"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true" focusable="false">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
						X (Twitter)
					</a>
					<a
						class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-blue-500 hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
						href="https://bsky.app/profile/nasuton-matome.bsky.social" target="_blank" rel="noopener noreferrer"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true" focusable="false">
							<path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.204-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/>
						</svg>
						Bluesky
					</a>
					<a
						class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-gray-800 hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
						href="https://github.com/nasuton" target="_blank" rel="noopener noreferrer"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true" focusable="false">
							<path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
						</svg>
						GitHub
					</a>
					<a
						class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-teal-400 hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
						href="https://note.com/nasuton_matome" target="_blank" rel="noopener noreferrer"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true" focusable="false">
							<path d="M21 3H3a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM8 17H6v-2h2v2zm0-4H6v-2h2v2zm0-4H6V7h2v2zm10 8H10v-2h8v2zm0-4H10v-2h8v2zm0-4H10V7h8v2z"/>
						</svg>
						note
					</a>
				</div>
			</section>
		</div>

		<!-- ===== 一般タブ ===== -->
		<div id="content-general" role="tabpanel" aria-labelledby="tab-general">
			<!-- 趣味セクション -->
			<section id="hobby" class="mb-12 scroll-mt-4">
				<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900" data-i18n="section.hobby">{t('section.hobby')}</h2>
				<ul class="list-disc list-inside flex flex-col gap-1 text-gray-600 leading-relaxed">
					<li data-i18n="hobby.reading">{t('hobby.reading')}</li>
					<li data-i18n="hobby.aquarium">{t('hobby.aquarium')}</li>
					<li data-i18n="hobby.game">{t('hobby.game')}</li>
					<li data-i18n="hobby.shrine">{t('hobby.shrine')}</li>
					<li data-i18n="hobby.filmCamera">{t('hobby.filmCamera')}</li>
				</ul>
			</section>

			<!-- 撮影機材セクション -->
			<section id="camera" class="mb-12 scroll-mt-4">
				<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900" data-i18n="section.camera">{t('section.camera')}</h2>
				<div class="flex flex-col gap-3">
					<div class="border border-gray-200 rounded-xl p-4 bg-white">
						<h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1" data-i18n="camera.smartphone">{t('camera.smartphone')}</h3>
						<ul class="list-disc list-inside text-gray-700">
							<li>iPhone 15 Pro</li>
							<li>Google Pixel 7 Pro</li>
						</ul>
					</div>
					<div class="border border-gray-200 rounded-xl p-4 bg-white">
						<h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1" data-i18n="camera.digital">{t('camera.digital')}</h3>
						<ul class="list-disc list-inside text-gray-700">
							<li>KODAK PIXPRO C1</li>
							<li>KODAK CHARMERA Keychain Digital Camera</li>
						</ul>
					</div>
					<div class="border border-gray-200 rounded-xl p-4 bg-white">
						<h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1" data-i18n="camera.film">{t('camera.film')}</h3>
						<ul class="list-disc list-inside text-gray-700">
							<li>PENTAX Zoom 60 DATE</li>
							<li>PENTAX ESPIO 115</li>
							<li>PENTAX SP + Super-Multi-Coated TAKUMAR 55mm F1.8</li>
							<li>Canon DEMI EE17</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- SNSセクション（一般タブ） -->
			<section id="sns-general" class="mb-12 scroll-mt-4">
				<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900" data-i18n="section.links">{t('section.links')}</h2>
				<div class="flex flex-wrap gap-3">
					<a
						class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-black hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
						href="https://x.com/Nasuton2" target="_blank" rel="noopener noreferrer"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true" focusable="false">
