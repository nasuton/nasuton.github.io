<script>
	import {
		translations,
		dateLocales,
		isLang,
		DEFAULT_LANG,
		LANG_STORAGE_KEY,
		type Lang,
	} from '../data/i18n';

	type TabName = 'general' | 'tech';

	// ===== 言語切り替え =====
	const langButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.lang-btn[data-lang]'));

	const LANG_ACTIVE_CLASSES = ['bg-white', 'text-indigo-600', 'shadow-sm'];
	const LANG_INACTIVE_CLASSES = ['text-gray-500', 'hover:text-gray-700'];

	const readStoredLang = (): Lang | null => {
		try {
			const stored = localStorage.getItem(LANG_STORAGE_KEY);
			return isLang(stored) ? stored : null;
		} catch {
			return null;
		}
	};

	const storeLang = (lang: Lang) => {
		try {
			localStorage.setItem(LANG_STORAGE_KEY, lang);
		} catch {
			// プライベートモード等で localStorage が使えない場合は無視
		}
	};

	const applyLang = (lang: Lang) => {
		const dict: Record<string, string> = translations[lang];

		document.documentElement.lang = lang;
		document.title = dict['meta.title'] ?? document.title;

		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
			const value = dict[el.dataset.i18n ?? ''];
			if (value !== undefined) el.textContent = value;
		});
		document.querySelectorAll<HTMLElement>('[data-i18n-aria-label]').forEach((el) => {
			const value = dict[el.dataset.i18nAriaLabel ?? ''];
			if (value !== undefined) el.setAttribute('aria-label', value);
		});
		document.querySelectorAll<HTMLImageElement>('[data-i18n-alt]').forEach((el) => {
			const value = dict[el.dataset.i18nAlt ?? ''];
			if (value !== undefined) el.alt = value;
		});
		document.querySelectorAll<HTMLTimeElement>('time[data-i18n-date][datetime]').forEach((el) => {
			const date = new Date(el.dateTime);
			if (!Number.isNaN(date.getTime())) {
				el.textContent = date.toLocaleDateString(dateLocales[lang], { year: 'numeric', month: 'long', day: 'numeric' });
			}
		});

		langButtons.forEach((btn) => {
			const isActive = btn.dataset.lang === lang;
			LANG_ACTIVE_CLASSES.forEach((c) => btn.classList.toggle(c, isActive));
			LANG_INACTIVE_CLASSES.forEach((c) => btn.classList.toggle(c, !isActive));
			btn.setAttribute('aria-pressed', String(isActive));
		});
	};

	if (langButtons.length > 0) {
		langButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const lang = btn.dataset.lang;
				if (!isLang(lang)) return;
				applyLang(lang);
				storeLang(lang);
			});
		});

		// 前回選択した言語を復元（HTML は日本語で描画済みなので、異なる場合のみ差し替える）
		const initialLang = readStoredLang() ?? DEFAULT_LANG;
		if (initialLang !== DEFAULT_LANG) {
			applyLang(initialLang);
		}
	}

	// ===== タブ切り替え =====
	const tabGeneral = document.getElementById('tab-general');
	const tabTech = document.getElementById('tab-tech');
	const contentGeneral = document.getElementById('content-general');
	const contentTech = document.getElementById('content-tech');
	const tocGeneral = document.getElementById('toc-general');
	const tocTech = document.getElementById('toc-tech');

	const ACTIVE_CLASSES = ['border-indigo-500', 'text-indigo-600', 'bg-indigo-50'];
	const INACTIVE_CLASSES = ['border-transparent', 'text-gray-500'];

	if (tabGeneral && tabTech && contentGeneral && contentTech && tocGeneral && tocTech) {
		const setTabState = (tab: HTMLElement, isActive: boolean) => {
			ACTIVE_CLASSES.forEach((c) => tab.classList.toggle(c, isActive));
			INACTIVE_CLASSES.forEach((c) => tab.classList.toggle(c, !isActive));
			tab.setAttribute('aria-selected', String(isActive));
		};

		const switchTab = (tab: TabName) => {
			const isGeneral = tab === 'general';

			setTabState(tabGeneral, isGeneral);
			setTabState(tabTech, !isGeneral);

			contentGeneral.classList.toggle('hidden', !isGeneral);
			contentTech.classList.toggle('hidden', isGeneral);
			tocGeneral.classList.toggle('hidden', !isGeneral);
			tocTech.classList.toggle('hidden', isGeneral);
		};

		tabGeneral.addEventListener('click', () => switchTab('general'));
		tabTech.addEventListener('click', () => switchTab('tech'));
	}

	// プロフィール画像の読み込みに失敗した場合はプレースホルダーを表示する
	const profileImage = document.getElementById('profile-image') as HTMLImageElement | null;
	const profilePlaceholder = document.getElementById('profile-placeholder');

	if (profileImage && profilePlaceholder) {
		const showPlaceholder = () => {
			profileImage.classList.add('hidden');
			profilePlaceholder.classList.remove('hidden');
			profilePlaceholder.classList.add('flex');
		};

		profileImage.addEventListener('error', showPlaceholder);
		// スクリプト実行前に既に読み込みが失敗していた場合のフォールバック
		if (profileImage.complete && profileImage.naturalWidth === 0) {
			showPlaceholder();
		}
	}
</script>

