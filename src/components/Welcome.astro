---
// プロフィール画像は public/profile.jpg に配置してください
import SkillBadge from './SkillBadge.astro';

interface PortfolioItem {
	title: string;
	description: string;
	url?: string;
	techs: string[];
}

const portfolio: PortfolioItem[] = [
	{
		title: 'ナストンのまとめ',
		description: '技術ブログ。気になった技術や日々の学びをまとめています',
		url: 'https://nasuton.net/blog/',
		techs: ['WordPress'],
	},
	{
    	title: 'パスワード生成ツール',
    	description: '安全なパスワードを生成するためのシンプルなツール。フロントエンドをReact、バックエンドをGo言語ginフレームワークで構築しています。',
    	url: 'https://nasuton.github.io/PasswordGeneration/',
    	techs: ['go', 'gin', 'react', 'typescript'],
    },
];

const skills = [
	'JavaScript',
	'TypeScript',
	'Python',
	'Rust',
	'C#',
	'C++',
	'Kotlin',
	'Linux',
	'Angular',
	'React',
	'Node.js',
	'Git',
	'GitHub',
	'Docker',
	'SQL Server',
    'PowerShell',
    'Mysql',
    'Go',
    'gin'
];
---

<div class="font-sans max-w-2xl mx-auto px-6 py-10 pb-16 text-gray-900">

	<!-- プロフィールヘッダー -->
	<header class="flex flex-col items-center text-center mb-10">
		<div class="w-28 h-28 rounded-full overflow-hidden mb-4 bg-gray-200 border-4 border-gray-300 flex items-center justify-center">
			<img
				id="profile-image"
				src="/profile.jpg"
				alt="プロフィール画像"
				class="w-full h-full object-cover"
				onerror="this.style.display='none'; document.getElementById('profile-placeholder').style.display='flex';"
			/>
			<div id="profile-placeholder" class="hidden w-full h-full items-center justify-center text-gray-400">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16">
					<path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
				</svg>
			</div>
		</div>
		<h1 class="text-3xl sm:text-4xl font-bold mb-2 leading-snug">ナストン</h1>
		<p class="text-base text-gray-500">熱しやすく冷めやすいプログラマー</p>
	</header>

	<!-- 目次 -->
	<nav class="bg-gray-50 border border-gray-200 rounded-xl px-6 py-5 mb-12">
		<h2 class="text-sm font-bold text-gray-600 uppercase tracking-widest mb-3">目次</h2>
		<ol class="list-decimal list-inside flex flex-col gap-1.5">
			<li><a href="#profile" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors">プロフィール</a></li>
			<li><a href="#skills" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors">スキル</a></li>
			<li><a href="#portfolio" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors">ポートフォリオ / 作品</a></li>
			<li><a href="#hobby" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors">趣味</a></li>
			<li><a href="#sns" class="text-indigo-600 hover:text-purple-500 hover:underline text-sm transition-colors">各リンク</a></li>
		</ol>
	</nav>

	<main class="min-h-full">
		<!-- プロフィールセクション -->
		<section id="profile" class="mb-12 scroll-mt-4">
			<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900">プロフィール</h2>
			<div>
				<p class="text-gray-600 leading-relaxed">気になったものはとりあえず触ってみる。現役プログラマー</p>
			</div>
		</section>

		<!-- スキルセクション -->
		<section id="skills" class="mb-12 scroll-mt-4">
			<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900">触ったことのあるもの</h2>
			<ul class="flex flex-wrap gap-2 list-none p-0 m-0">
				{skills.map((skill) => (
					<SkillBadge name={skill} />
				))}
			</ul>
		</section>

		<!-- ポートフォリオセクション -->
		<section id="portfolio" class="mb-12 scroll-mt-4">
			<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900">ポートフォリオ / 作品</h2>
			<div class="flex flex-col gap-4">
				{portfolio.map((item) => (
					<div class="border border-gray-200 rounded-xl p-5 bg-white hover:shadow-md transition-shadow">
						<div class="flex items-start justify-between gap-3 mb-2">
							<h3 class="text-base font-semibold text-gray-900">{item.title}</h3>
							{item.url && (
								<a
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold text-white bg-indigo-500 hover:bg-indigo-600 hover:-translate-y-0.5 transition-all flex-shrink-0"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
										<path d="M14 3v2H7v14h14v-7h2v8a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h8zm7 0v7h-2V6.413l-7.293 7.294-1.414-1.414L19.585 5H15V3h6z"/>
									</svg>
									リンク
								</a>
							)}
						</div>
						<p class="text-sm text-gray-600 leading-relaxed mb-3">{item.description}</p>
						{item.techs.length > 0 && (
							<div>
								<p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">使用技術</p>
								<ul class="flex flex-wrap gap-2 list-none p-0 m-0">
									{item.techs.map((tech) => (
										<SkillBadge name={tech} />
									))}
								</ul>
							</div>
						)}
					</div>
				))}
			</div>
		</section>

		<!-- 趣味セクション -->
		<section id="hobby" class="mb-12 scroll-mt-4">
			<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900">趣味</h2>
			<div>
				<p class="text-gray-600 leading-relaxed">・読書</p>
				<p class="text-gray-600 leading-relaxed">・水族館巡り</p>
				<p class="text-gray-600 leading-relaxed">・ゲーム</p>
				<p class="text-gray-600 leading-relaxed">・社寺巡り</p>
			</div>
		</section>

		<!-- SNSセクション -->
		<section id="sns" class="mb-12 scroll-mt-4">
			<h2 class="text-xl sm:text-2xl font-bold mb-4 pb-2 border-b-2 border-gray-200 text-gray-900">SNS</h2>
			<div class="flex flex-wrap gap-3">
				<a
					class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-orange-500 hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
					href="https://nasuton.net/blog/" target="_blank" rel="noopener noreferrer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
						<path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
					</svg>
					ナストンのまとめ
				</a>
				<a
					class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-black hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
					href="https://x.com/nasuton_matome" target="_blank" rel="noopener noreferrer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
						<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
					</svg>
					X (Twitter)
				</a>
				<a
					class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-blue-500 hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
					href="https://bsky.app/profile/nasuton-matome.bsky.social" target="_blank" rel="noopener noreferrer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
						<path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.204-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/>
					</svg>
					Bluesky
				</a>
				<a
					class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-teal-400 hover:opacity-85 hover:-translate-y-0.5 transition-all sm:w-auto w-full justify-center"
					href="https://note.com/nasuton_matome" target="_blank" rel="noopener noreferrer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
						<path d="M21 3H3a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM8 17H6v-2h2v2zm0-4H6v-2h2v2zm0-4H6V7h2v2zm10 8H10v-2h8v2zm0-4H10v-2h8v2zm0-4H10V7h8v2z"/>
					</svg>
					note
				</a>
			</div>
		</section>
	</main>
</div>

