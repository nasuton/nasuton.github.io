	<!-- トップに戻るボタン（1 画面分スクロールしたら表示。両タブ共通でページに 1 つ） -->
	<button
		type="button"
		id="back-to-top"
		class="fixed bottom-4 right-4 z-40 inline-flex items-center justify-center w-11 h-11 rounded-full bg-indigo-600 text-white shadow-lg hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-[opacity,transform,background-color] duration-300 opacity-0 translate-y-4 pointer-events-none motion-reduce:transition-none"
		aria-label={t('backToTop.label')}
		data-i18n-aria-label="backToTop.label"
		title={t('backToTop.label')}
		data-i18n-title="backToTop.label"
		aria-hidden="true"
		tabindex="-1"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true" focusable="false">
			<path d="M12 19V5m0 0l-7 7m7-7l7 7" />
		</svg>
	</button>
</div>

<script>
	import {
		translations,
		dateLocales,
		isLang,
		DEFAULT_LANG,
		LANG_STORAGE_KEY,
		type Lang,
	} from '../data/i18n';

	type TabName = 'general' | 'tech';

	// ===== 言語切り替え =====
	const langButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.lang-btn[data-lang]'));

	const LANG_ACTIVE_CLASSES = ['bg-white', 'text-indigo-600', 'shadow-sm'];
	const LANG_INACTIVE_CLASSES = ['text-gray-500', 'hover:text-gray-700'];

	const readStoredLang = (): Lang | null => {
		try {
			const stored = localStorage.getItem(LANG_STORAGE_KEY);
			return isLang(stored) ? stored : null;
		} catch {
			return null;
		}
	};

	const storeLang = (lang: Lang) => {
		try {
			localStorage.setItem(LANG_STORAGE_KEY, lang);
		} catch {
			// プライベートモード等で localStorage が使えない場合は無視
		}
	};

	const applyLang = (lang: Lang) => {
		const dict: Record<string, string> = translations[lang];

		document.documentElement.lang = lang;
		document.title = dict['meta.title'] ?? document.title;

		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
			const value = dict[el.dataset.i18n ?? ''];
			if (value !== undefined) el.textContent = value;
		});
		// 件数などを埋め込む文言: 辞書の {count} を data-i18n-count の値で置換する
		document.querySelectorAll<HTMLElement>('[data-i18n-template]').forEach((el) => {
			const value = dict[el.dataset.i18nTemplate ?? ''];
			if (value !== undefined) el.textContent = value.replace('{count}', el.dataset.i18nCount ?? '');
		});
		document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((el) => {
			const value = dict[el.dataset.i18nPlaceholder ?? ''];
			if (value !== undefined) el.setAttribute('placeholder', value);
		});
		document.querySelectorAll<HTMLElement>('[data-i18n-aria-label]').forEach((el) => {
			const value = dict[el.dataset.i18nAriaLabel ?? ''];
			if (value !== undefined) el.setAttribute('aria-label', value);
		});
		document.querySelectorAll<HTMLElement>('[data-i18n-title]').forEach((el) => {
			const value = dict[el.dataset.i18nTitle ?? ''];
			if (value !== undefined) el.title = value;
		});
		document.querySelectorAll<HTMLImageElement>('[data-i18n-alt]').forEach((el) => {
			const value = dict[el.dataset.i18nAlt ?? ''];
			if (value !== undefined) el.alt = value;
		});
		document.querySelectorAll<HTMLTimeElement>('time[data-i18n-date][datetime]').forEach((el) => {
			const date = new Date(el.dateTime);
			if (!Number.isNaN(date.getTime())) {
				el.textContent = date.toLocaleDateString(dateLocales[lang], { year: 'numeric', month: 'long', day: 'numeric' });
			}
		});

		langButtons.forEach((btn) => {
			const isActive = btn.dataset.lang === lang;
			LANG_ACTIVE_CLASSES.forEach((c) => btn.classList.toggle(c, isActive));
			LANG_INACTIVE_CLASSES.forEach((c) => btn.classList.toggle(c, !isActive));
			btn.setAttribute('aria-pressed', String(isActive));
		});
	};

	if (langButtons.length > 0) {
		langButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const lang = btn.dataset.lang;
				if (!isLang(lang)) return;
				applyLang(lang);
				storeLang(lang);
			});
		});

		// 前回選択した言語を復元（HTML は日本語で描画済みなので、異なる場合のみ差し替える）
		const initialLang = readStoredLang() ?? DEFAULT_LANG;
		if (initialLang !== DEFAULT_LANG) {
			applyLang(initialLang);
		}
	}

	// ===== トップに戻るボタン =====
	const backToTop = document.getElementById('back-to-top');
	const pageTop = document.getElementById('page-top');
	const HIDDEN_CLASSES = ['opacity-0', 'translate-y-4', 'pointer-events-none'];
	let backToTopVisible = false;
	let backToTopFrame = 0;

	const updateBackToTop = () => {
		backToTopFrame = 0;
		if (!backToTop) return;
		// 1 画面分（ビューポートの高さ）スクロールしたら表示する
		const visible = window.scrollY > window.innerHeight;
		if (visible === backToTopVisible) return;
		backToTopVisible = visible;
		HIDDEN_CLASSES.forEach((c) => backToTop.classList.toggle(c, !visible));
		// 非表示中はフォーカス順と支援技術から外す
		backToTop.setAttribute('aria-hidden', String(!visible));
		backToTop.tabIndex = visible ? 0 : -1;
	};
	const scheduleBackToTop = () => {
		if (backToTopFrame === 0) backToTopFrame = requestAnimationFrame(updateBackToTop);
	};

	if (backToTop) {
		window.addEventListener('scroll', scheduleBackToTop, { passive: true });
		window.addEventListener('resize', scheduleBackToTop, { passive: true });
		backToTop.addEventListener('click', () => {
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
			// キーボード利用者が迷子にならないようフォーカスを先頭へ移す
			pageTop?.focus({ preventScroll: true });
		});
		updateBackToTop();
	}

	// ===== ポートフォリオの「続きを見る」 =====
	// SSR では全件を出力し、JS 有効時のみ 4 件目以降を隠す（プログレッシブエンハンスメント）
	const portfolioToggle = document.getElementById('portfolio-toggle') as HTMLButtonElement | null;
	const portfolioToggleLabel = document.getElementById('portfolio-toggle-label');
	const portfolioExtras = Array.from(document.querySelectorAll<HTMLElement>('[data-portfolio-extra]'));

	if (portfolioToggle && portfolioToggleLabel && portfolioExtras.length > 0) {
		const currentLang = (): Lang => {
			const lang = document.documentElement.lang;
			return isLang(lang) ? lang : DEFAULT_LANG;
		};

		const setPortfolioExpanded = (expanded: boolean) => {
			portfolioExtras.forEach((el) => el.classList.toggle('hidden', !expanded));
			portfolioToggle.setAttribute('aria-expanded', String(expanded));
			portfolioToggle.querySelector('.portfolio-toggle-icon')?.classList.toggle('rotate-180', expanded);
			// ラベルは辞書キーを差し替えておき、以降の言語切替は applyLang に任せる
			const key = expanded ? 'portfolio.showLess' : 'portfolio.showMore';
			portfolioToggleLabel.dataset.i18nTemplate = key;
			const dict: Record<string, string> = translations[currentLang()];
			const template = dict[key];
			if (template !== undefined) {
				portfolioToggleLabel.textContent = template.replace('{count}', portfolioToggleLabel.dataset.i18nCount ?? '');
			}
		};

		portfolioToggle.addEventListener('click', () => {
			const expanded = portfolioToggle.getAttribute('aria-expanded') !== 'true';
			setPortfolioExpanded(expanded);
			if (!expanded) {
				// 折りたたみでページが縮み、押したボタンが画面外へ出た場合だけ見える位置まで戻す
				const rect = portfolioToggle.getBoundingClientRect();
				if (rect.top < 0 || rect.bottom > window.innerHeight) {
					const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					portfolioToggle.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
				}
			}
			// 展開・折りたたみでページ高が変わるのでボタンの表示判定をやり直す
			scheduleBackToTop();
		});

		setPortfolioExpanded(false);
	}

	// ===== タブ切り替え =====
	const tabGeneral = document.getElementById('tab-general');
	const tabTech = document.getElementById('tab-tech');
	const contentGeneral = document.getElementById('content-general');
	const contentTech = document.getElementById('content-tech');
	const tocGeneral = document.getElementById('toc-general');
	const tocTech = document.getElementById('toc-tech');

	const ACTIVE_CLASSES = ['border-indigo-500', 'text-indigo-600', 'bg-indigo-50'];
	const INACTIVE_CLASSES = ['border-transparent', 'text-gray-500'];

	if (tabGeneral && tabTech && contentGeneral && contentTech && tocGeneral && tocTech) {
		const setTabState = (tab: HTMLElement, isActive: boolean) => {
			ACTIVE_CLASSES.forEach((c) => tab.classList.toggle(c, isActive));
			INACTIVE_CLASSES.forEach((c) => tab.classList.toggle(c, !isActive));
			tab.setAttribute('aria-selected', String(isActive));
		};

		const switchTab = (tab: TabName) => {
			const isGeneral = tab === 'general';

			setTabState(tabGeneral, isGeneral);
			setTabState(tabTech, !isGeneral);

			contentGeneral.classList.toggle('hidden', !isGeneral);
			contentTech.classList.toggle('hidden', isGeneral);
			tocGeneral.classList.toggle('hidden', !isGeneral);
			tocTech.classList.toggle('hidden', isGeneral);
			// タブ切替でページ高が変わるのでボタンの表示判定をやり直す
			scheduleBackToTop();
		};

		tabGeneral.addEventListener('click', () => switchTab('general'));
		tabTech.addEventListener('click', () => switchTab('tech'));
	}

	// プロフィール画像の読み込みに失敗した場合はプレースホルダーを表示する
	const profileImage = document.getElementById('profile-image') as HTMLImageElement | null;
	const profilePlaceholder = document.getElementById('profile-placeholder');

	if (profileImage && profilePlaceholder) {
		const showPlaceholder = () => {
			profileImage.classList.add('hidden');
			profilePlaceholder.classList.remove('hidden');
			profilePlaceholder.classList.add('flex');
		};

		profileImage.addEventListener('error', showPlaceholder);
		// スクリプト実行前に既に読み込みが失敗していた場合のフォールバック
		if (profileImage.complete && profileImage.naturalWidth === 0) {
			showPlaceholder();
		}
	}
</script>

